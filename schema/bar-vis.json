{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 400,
    "height": 250,
    "data": {
      "url": "https://raw.githubusercontent.com/monash-stu/Tourism-Visualisation/main/data/visitors-by-state-of-stay-trend.csv",
      "format": {"type": "csv"}
    },
    "selection": {
        "yearFilter": {
            "type": "single",
            "fields": ["Year"],
            "bind": {
                "input": "select",
                "options": [2014, 2019, 2024],
                "name": "Select Year: "
            },
            "init": {"Year": 2024}
        }
    },
    "transform": [
        {
            "filter": "datum.Year == yearFilter.Year"
        }
    ],
    "mark": "bar",
    "encoding": {
        "x": {
            "field": "State",
            "type": "nominal",
            "title": "State"
        },
        "y": {
            "field": "Visitors",
            "type": "quantitative",
            "title": "Total Visitors"
        },
        "color": {
            "field": "State",
            "type": "nominal",
            "title": "State"
        },
        "tooltip": [
            {"field": "State", "type": "nominal", "title": "State"},
            {"field": "Year", "type": "ordinal", "title": "Year"},
            {"field": "Visitors", "type": "quantitative", "title": "Total Visitors"}
        ]
    }
}  