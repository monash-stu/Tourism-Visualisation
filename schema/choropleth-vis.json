{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 300,
  "projection": {
    "type": "mercator",
    "scale": 400,
    "center": [135, -28]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/monash-stu/Tourism-Visualisation/main/STE_2016_AUST.json",
    "format": { "type": "topojson", "feature": "STE_2016_AUST" }
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME16",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/monash-stu/Tourism-Visualisation/main/data/visitors-by-state-of-stay.csv"
        },
        "key": "Region",
        "fields": ["Arrivals"]
      }
    },
    {
      "window": [{"op": "sum", "field": "Arrivals", "as": "TotalArrivals"}],
      "frame": [null, null]
    },
    {
      "calculate": "datum.Arrivals / datum.TotalArrivals * 100",
      "as": "Visitor Percentage"
    }
  ],
  "layer": [
    {
      "mark": { "type": "geoshape" },
      "encoding": {
        "color": {
          "field": "Visitor Percentage",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [1, 5, 10, 20, 30, 50],
            "range": ["#fff7fb", "#ece7f2", "#d0d1e6", "#a6bddb", "#74a9cf", "#3690c0", "#034e7b"]
          }
        },
        "tooltip": [
          { "field": "properties.STE_NAME16", "type": "nominal", "title": "Region" },
          { "field": "Visitor Percentage", "type": "quantitative", "title": "Percentage of Total Visitors", "format": ".2f" }
        ]
      }
    },
    {
      "mark": {
        "type": "geoshape",
        "stroke": "lightgray",
        "strokeWidth": 0.5
      },
      "data": {
        "graticule": {
          "step": [10, 5]
        }
      },
      "encoding": {
        "shape": {
          "field": "graticule"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}